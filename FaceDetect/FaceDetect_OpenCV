import cv2
import os
import time

# Load the Haar cascade classifier using the default path provided by OpenCV
face_detector = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_frontalface_default.xml')
eye_detector = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_eye.xml')

# Picture folder path
folder_path = r"/Users/14350/PycharmProjects/PythonProject1/sample"

# Statistics
total_images = 0
detected_faces = 0
no_faces = 0
detected_eyes = 0

# Record the start time
start_time = time.time()

# Walk through all the images in the folder
for filename in os.listdir(folder_path):
    if total_images >= 20000:
        break

    img_path = os.path.join(folder_path, filename)

    # Only.jpg,.png,.jpeg files are processed
    if not filename.lower().endswith(('.jpg', '.png', '.jpeg')):
        continue

    total_images += 1
    img = cv2.imread(img_path)

    # Check if the image loaded successfully
    if img is None:
        print(f"Warning: Cannot open image {filename}. Skipping...")
        continue

    # Convert to grayscale
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

    # Perform face detection
    faces = face_detector.detectMultiScale(gray, 1.3, 5)

    if len(faces) > 0:
        detected_faces += 1
        # Draw the face frame
        for (x, y, w, h) in faces:
            img = cv2.rectangle(img, (x, y), (x + w, y + h), (255, 0, 0), 2)
            roi_gray = gray[y:y + h, x:x + w]
            roi_color = img[y:y + h, x:x + w]

            # Get an eye test
            eyes = eye_detector.detectMultiScale(roi_gray)
            for (ex, ey, ew, eh) in eyes:
                detected_eyes += 1
                cv2.rectangle(roi_color, (ex, ey), (ex + ew, ey + eh), (0, 255, 0), 2)

        # Show Result
        #cv2.imshow(f"Detected Faces - {filename}", img)
        #cv2.waitKey(500)
        #cv2.destroyAllWindows()
    else:
        no_faces += 1
        print(f"Can't Detect Face: {filename}")

# End of record time
end_time = time.time()
total_time = end_time - start_time

# Print Result
print(f"Total Images Processed: {total_images}")
print(f"Images with Detected Faces: {detected_faces}")
print(f"Images with No Faces: {no_faces}")
print(f"Images with Detected eyes: {detected_eyes}")
print(f"Total Processing Time: {total_time:.2f} seconds")
